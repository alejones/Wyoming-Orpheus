# Multi-stage build for Wyoming Orpheus TTS on NVIDIA Jetson (ARM64/aarch64).
# Uses L4T (Linux for Tegra) base images from JetPack 6.x with CUDA 12.2.
# Builder compiles llama-cpp-python with CUDA; runtime copies only what is needed.
#
# Target hardware: Jetson Orin (AGX, NX, Nano), Xavier series
# Requires JetPack 6.x installed on the host device.
#
# Base image tags available at  https://catalog.ngc.nvidia.com/orgs/nvidia/containers/l4t-cuda

# Stage 1: Build environment (devel image required for CUDA headers and nvcc)
FROM nvcr.io/nvidia/l4t-cuda:12.2.12-devel AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV CMAKE_ARGS="-DGGML_CUDA=on -DLLAVA_BUILD=off -DCUDAToolkit_ROOT=/usr/local/cuda"
ENV PYTHONPATH="/app"

# pyenv root and shims on PATH so all subsequent RUN steps use pyenv Python
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:${PATH}"
ENV PYTHON_VERSION="3.12"

# Install build dependencies for llama-cpp-python and pyenv
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    gcc \
    g++ \
    git \
    curl \
    libssl-dev \
    libffi-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    liblzma-dev \
    zlib1g-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install pyenv and Python
RUN curl https://pyenv.run | bash \
    && pyenv install ${PYTHON_VERSION} \
    && pyenv global ${PYTHON_VERSION} \
    && pyenv rehash

WORKDIR /app

RUN pip install --break-system-packages pipenv

COPY Pipfile* ./
RUN PIP_BREAK_SYSTEM_PACKAGES=1 pipenv install --deploy --system

# Copy the application code
COPY wyoming_orpheus/ ./wyoming_orpheus/

# Stage 2: Runtime environment
FROM nvcr.io/nvidia/l4t-cuda:12.2.12-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV PYTHONPATH="/app"

# pyenv Python takes precedence over the system Python
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:${PATH}"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy pyenv Python installation and application from builder
COPY --from=builder /root/.pyenv /root/.pyenv
COPY --from=builder /app /app

# Rehash shims so pyenv resolves python3 correctly in the runtime stage
RUN pyenv rehash

# Create directory for model caching
RUN mkdir -p /models

# Default model parameters (GPU layers enabled by default for Jetson)
ENV MODEL_PATH="orpheus-3b-0.1-ft-Q4_K_M.gguf"
ENV VOICE="tara"
ENV N_THREADS=4
ENV N_GPU_LAYERS=-1
ENV PORT=10200

EXPOSE 10200

# Write entrypoint script
RUN cat <<'EOF' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh
#!/bin/bash
python3 -m wyoming_orpheus \
  --uri "tcp://0.0.0.0:$PORT" \
  --voice "$VOICE" \
  --n-threads "$N_THREADS" \
  --n-gpu-layers "$N_GPU_LAYERS" \
  --model-path "$MODEL_PATH" \
  --model-cache-dir /models \
  "$@"
EOF

ENTRYPOINT ["/app/entrypoint.sh"]
